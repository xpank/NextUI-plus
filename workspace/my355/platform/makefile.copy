$(PLATFORM):
	# installer
	cp ./workspace/$@/install/boot.sh ./build/BOOT/common/$@.sh
	cp ./workspace/$@/install/update.sh ./build/SYSTEM/$@/bin/install.sh
	mkdir -p ./build/BOOT/common/$@/
	cp ./workspace/$@/install/*.png ./build/BOOT/common/$@/
	cp ./workspace/all/show2/build/$@/show2.elf ./build/BOOT/common/$@/
	# rfkill
	cp ./workspace/$@/rfkill/rfkill.elf ./build/SYSTEM/$@/bin/

	# extras
	cp ./workspace/$@/other/NextCommander/output/NextCommander ./build/EXTRAS/Tools/$@/Files.pak/
	cp -r ./workspace/$@/other/NextCommander/res ./build/EXTRAS/Tools/$@/Files.pak/
	
	mkdir -p ./build/EXTRAS/Tools/$@/Bootlogo.pak/payload/bin/
	cp ./workspace/$@/other/mkbootimg/mkbootimg ./build/EXTRAS/Tools/$@/Bootlogo.pak/payload/bin/
	cp ./workspace/$@/other/mkbootimg/unpackbootimg ./build/EXTRAS/Tools/$@/Bootlogo.pak/payload/bin/
	cp ./workspace/$@/other/rsce-go/rsce_tool ./build/EXTRAS/Tools/$@/Bootlogo.pak/payload/bin/

	# Optional preview runtime: real files named by their ABI sonames for FAT.
	cp -L ./workspace/$@/ffmpeg/output/lib/libavutil.so.58 ./build/SYSTEM/$@/lib/
	cp -L ./workspace/$@/ffmpeg/output/lib/libavcodec.so.60 ./build/SYSTEM/$@/lib/
	cp -L ./workspace/$@/ffmpeg/output/lib/libavformat.so.60 ./build/SYSTEM/$@/lib/
